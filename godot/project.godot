; Engine configuration for the Deadshift V3 Android prototype
config_version=5

[application]
config/name="Deadshift V3"
run/main_scene="res://scenes/Outskirts.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Deadshift Gas Station Outskirts tutorial district prototype"

[display]
window/size/viewport_width=432
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[autoload]
SoundManager="*res://scripts/sound_manager.gd"
